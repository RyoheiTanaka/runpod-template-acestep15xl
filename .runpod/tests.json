{
  "tests": [
    {
      "name": "comfyui_serves_system_stats",
      "input": {
        "health_check": true
      },
      "timeout": 900000
    },
    {
      "name": "generates_audio_with_official_xl_turbo_workflow",
      "input": {
        "workflow": {
          "1": {
            "class_type": "UNETLoader",
            "inputs": {
              "unet_name": "acestep_v1.5_xl_turbo_bf16.safetensors",
              "weight_dtype": "default"
            }
          },
          "2": {
            "class_type": "VAELoader",
            "inputs": {
              "vae_name": "ace_1.5_vae.safetensors"
            }
          },
          "3": {
            "class_type": "DualCLIPLoader",
            "inputs": {
              "clip_name1": "qwen_0.6b_ace15.safetensors",
              "clip_name2": "qwen_4b_ace15.safetensors",
              "type": "ace",
              "device": "default"
            }
          },
          "4": {
            "class_type": "ModelSamplingAuraFlow",
            "inputs": {
              "model": [
                "1",
                0
              ],
              "shift": 3
            }
          },
          "5": {
            "class_type": "TextEncodeAceStepAudio1.5",
            "inputs": {
              "clip": [
                "3",
                0
              ],
              "tags": "lo-fi hip hop, mellow electric piano, soft drums, instrumental",
              "lyrics": "",
              "seed": 0,
              "bpm": 95,
              "duration": 10.0,
              "timesignature": "4",
              "language": "en",
              "keyscale": "E minor",
              "generate_audio_codes": true,
              "cfg_scale": 2.0,
              "temperature": 0.85,
              "top_p": 0.9,
              "top_k": 0,
              "min_p": 0.0
            }
          },
          "6": {
            "class_type": "ConditioningZeroOut",
            "inputs": {
              "conditioning": [
                "5",
                0
              ]
            }
          },
          "7": {
            "class_type": "EmptyAceStep1.5LatentAudio",
            "inputs": {
              "seconds": 10.0,
              "batch_size": 1
            }
          },
          "8": {
            "class_type": "KSampler",
            "inputs": {
              "model": [
                "4",
                0
              ],
              "positive": [
                "5",
                0
              ],
              "negative": [
                "6",
                0
              ],
              "latent_image": [
                "7",
                0
              ],
              "seed": 0,
              "steps": 8,
              "cfg": 1,
              "sampler_name": "euler",
              "scheduler": "simple",
              "denoise": 1
            }
          },
          "9": {
            "class_type": "VAEDecodeAudio",
            "inputs": {
              "samples": [
                "8",
                0
              ],
              "vae": [
                "2",
                0
              ]
            }
          },
          "10": {
            "class_type": "SaveAudioAdvanced",
            "inputs": {
              "audio": [
                "9",
                0
              ],
              "filename_prefix": "audio/hub_test",
              "format": "mp3",
              "quality": "V0"
            }
          }
        }
      },
      "timeout": 900000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA RTX A5000",
    "gpuCount": 1,
    "env": [
      {
        "key": "COMFY_PORT",
        "value": "8188"
      },
      {
        "key": "ACESTEP_XL_VARIANT",
        "value": "xl_turbo"
      }
    ],
    "allowedCudaVersions": [
      "13.2",
      "13.1",
      "13.0",
      "12.9",
      "12.8",
      "12.7",
      "12.6",
      "12.5",
      "12.4"
    ]
  }
}
